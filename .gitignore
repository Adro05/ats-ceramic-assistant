# Generated synthetic data is reproducible from a seed; keep only the placeholder.
data/synthetic/*
!data/synthetic/.gitkeep

# Guard against accidentally committing real client data.
data/client/
data/private/

# Runtime artifacts (audit logs, registries) created by later phases
runtime/

